				VariableProp('l1', 'UD', 'Length of the entire metallic patch, along Y axis, parallel to the polarization direction', '10.9mm')
				VariableProp('l3', 'UD', 'Width of the connection between center patch and two small arms. There are one upper arm and one lower arm next to the center patch, connected by PIN diodes, so  that we can control reflected phase with diodes on or off.', '1.1mm')
