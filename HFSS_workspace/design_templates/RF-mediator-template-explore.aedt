				A_fromS(ID=2, '( (1+S(FloquetPort1:1,FloquetPort1:1)) * (1-S(FloquetPort2:1,FloquetPort2:1)) + S(FloquetPort1:1,FloquetPort2:1) * S(FloquetPort2:1,FloquetPort1:1) ) / (2 * S(FloquetPort2:1,FloquetPort1:1))', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				C_fromS(ID=3, '( (1-S(FloquetPort1:1,FloquetPort1:1)) * (1-S(FloquetPort2:1,FloquetPort2:1)) - S(FloquetPort1:1,FloquetPort2:1) * S(FloquetPort2:1,FloquetPort1:1) ) / (2 * S(FloquetPort2:1,FloquetPort1:1) * 377)', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				corrected_Y(ID=4, '(Y_from_Z - 1j/377*sin(air_beta *air_thickness) ) / (cos(air_beta*air_thickness/2)^2)', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				air_beta(ID=5, '2*pi*Freq/3e8', 1, 'GHz', 1, 'GHz', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
