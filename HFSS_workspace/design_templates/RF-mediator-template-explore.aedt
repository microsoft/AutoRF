		DCThicknessObjects(102, '"<Effective>"', 141, '"<Effective>"', 207, '"<Effective>"', 430, '"<Effective>"', 496, '"<Effective>"', 558, '"<Effective>"', 830, '"<Effective>"', 847, '"<Effective>"')
		$begin 'OutputVariable'
			NextUniqueID=8
			MoveBackwards=false
			$begin 'OutputVariables'
				Y_from_Z(ID=0, '1/Z(FloquetPort2:1,FloquetPort1:1)', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				A_fromS(ID=2, '( (1+S(FloquetPort1:1,FloquetPort1:1)) * (1-S(FloquetPort2:1,FloquetPort2:1)) + S(FloquetPort1:1,FloquetPort2:1) * S(FloquetPort2:1,FloquetPort1:1) ) / (2 * S(FloquetPort2:1,FloquetPort1:1))', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				C_fromS(ID=3, '( (1-S(FloquetPort1:1,FloquetPort1:1)) * (1-S(FloquetPort2:1,FloquetPort2:1)) - S(FloquetPort1:1,FloquetPort2:1) * S(FloquetPort2:1,FloquetPort1:1) ) / (2 * S(FloquetPort2:1,FloquetPort1:1) * 377)', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				corrected_Y(ID=4, '(Y_from_Z - 1j/377*sin(air_beta *air_thickness) ) / (cos(air_beta*air_thickness/2)^2)', 2, '', 2, '', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				air_beta(ID=5, '2*pi*Freq/3e8', 1, 'GHz', 1, 'GHz', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				air_Z(ID=6, '377ohm', 1, 'ohm', 1, 'ohm', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
				sub_Z(ID=7, '377ohm / sqrt(3.55)', 1, 'ohm', 1, 'ohm', 3, 0, 2, 0, false, false, -1, 1, 0, 1, 1, '', 0, 0)
			$end 'OutputVariables'
		$end 'OutputVariable'
		$begin 'ModelSetup'
			$begin 'DesignDatasets'
				NextUniqueID=0
				MoveBackwards=false
				DatasetType='DesignDatasetType'
				$begin 'DatasetDefinitions'
				$end 'DatasetDefinitions'
			$end 'DesignDatasets'
			$begin 'Properties'
				VariableProp('air_thickness', 'UD', 'Thickness of the airbox for simulation, one wavelength', '122mm')
				VariableProp('sub_XSize', 'UD', 'Length of the substrate along X axis, for one surface element', '2*(PatchSizeX+PatchGapX)')
				VariableProp('sub_YSize', 'UD', 'Width of the substrate along Yaxis, for one surface element', '30mm')
				VariableProp('sub_PosX', 'UD', 'Start position of substrate along X axis, provides offset, should be fixed to 0', '0')
				VariableProp('sub_PosY', 'UD', 'Start position of substrate along Y axis, provides offset, should be fixed to 0', '0')
				VariableProp('copper_thickness', 'UD', 'Thickness of the copper layer in the PCB, fixed by fabrication process', '0.02mm')
				VariableProp('sub_PosZ', 'UD', 'Start position of substrate along Z axis, provides offset, should be fixed', 'copper_thickness')
				VariableProp('sub_thickness', 'UD', 'One forth of the thickness of the PCB substrate', '0.025mm')
				VariableProp('PatchSizeX', 'UD', 'Length of the center patch of the surface pattern, each element has two patches connected by varactor', '15.3mm')
				VariableProp('PatchSizeY', 'UD', 'Width of the center patch of the surface element', '23mm')
				VariableProp('PatchGapX', 'UD', 'The gap between two patches, used to host varactor, fixed as we do not plan to change varactor', '0.7mm')
				VariableProp('wireYSize', 'UD', 'Biasing wire width along Y axis, biasing wire is to supply voltage for varactor', '0.5mm')
				VariableProp('wireGapY', 'UD', 'Biasing wire gap between wires along Y axis', '0.3mm')
				VariableProp('GNDconnetXSize', 'UD', 'Width of the connection between GND and patch', '3.5mm')
				VariableProp('viaRadius', 'UD', 'Radius of the via, via is used to router the wire and supply voltage to varactor', '0.2mm')
				VariableProp('viaPosX', 'UD', 'Position of the visa along X axis, fixed by equation', 'sub_XSize/2')
				VariableProp('viaPosY', 'UD', 'Position of the visa along Y axis, fixed by equation', 'sub_PosY + sub_YSize/2 + PatchSizeY/2 +(wireYSize+wireGapY)*4 -wireYSize/2')
