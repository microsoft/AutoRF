# AutoRF environment variables
#
# Copy this file to `.env` (or export these variables in your shell) and fill in
# the credentials for the LLM backend(s) you plan to use. NEVER commit real keys.
#
# The framework can use different LLM providers via GetLLMInterface(model_name, model_provider).

# --- OpenAI (model_provider="OpenAI") ---
# Used by the standard OpenAI Python SDK (reads OPENAI_API_KEY automatically).
OPENAI_API_KEY=

# --- OpenRouter (model_provider="OpenRouter") ---
OPENROUTER_API_KEY=

# --- NVIDIA API Catalog (model_provider="Nvidia") ---
NVIDIA_API_KEY=

# --- Optional: override the HFSS workspace folder used by the EM simulator ---
# AUTORF_HFSS_WORKSPACE=/absolute/path/to/HFSS_workspace
